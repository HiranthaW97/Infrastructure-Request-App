@page "/login"
@attribute [AllowAnonymous]
@layout AuthLayout
@using InfrastructureRequestApp.Data.Services.Interfaces
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.Extensions.Caching.Memory
@inject IAuthService Auth
@inject NavigationManager Nav
@inject IMemoryCache Cache

<div class="login-page">
    <main class="login-main">
        <!-- Left: brand / visual panel (hidden on mobile) -->
        <aside class="login-visual">
            <div class="login-visual-overlay"></div>
            <div class="login-glass">
                <i class="material-icons login-glass-icon">dns</i>
                <h1 class="login-glass-title">InfraRequest</h1>
                <p class="login-glass-sub">Enterprise IT Infrastructure Management &amp; Connectivity Portal</p>
            </div>
        </aside>

        <!-- Right: login form -->
        <section class="login-form-area">
            <div class="login-card">
                <!-- Mobile logo (left panel is hidden on small screens) -->
                <div class="login-mobile-logo">
                    <i class="material-icons login-mobile-icon">dns</i>
                    <h1 class="login-mobile-name">InfraRequest</h1>
                </div>

                <div class="login-welcome">
                    <h2>Welcome back</h2>
                    <p>Please sign in to your enterprise account.</p>
                </div>

                @if (errorMessage is not null)
                {
                    <div class="login-error">
                        <i class="material-icons">error_outline</i>
                        <span>@errorMessage</span>
                    </div>
                }

                <div class="login-field">
                    <i class="material-icons login-field-icon">person</i>
                    <input class="login-input"
                           id="username"
                           placeholder="Username"
                           @bind="userName"
                           @bind:event="oninput"
                           @onkeydown="OnKeyDown" />
                    <label class="login-label" for="username">Username</label>
                </div>

                <div class="login-field">
                    <i class="material-icons login-field-icon">lock</i>
                    <input class="login-input"
                           id="password"
                           type="password"
                           placeholder="Password"
                           @bind="password"
                           @bind:event="oninput"
                           @onkeydown="OnKeyDown" />
                    <label class="login-label" for="password">Password</label>
                </div>

                <div class="login-options">
                    <label class="login-remember">
                        <input type="checkbox" @bind="rememberMe" />
                        <span>Remember me</span>
                    </label>
                    <a class="login-forgot" href="javascript:void(0)">Forgot password?</a>
                </div>

                <button class="login-submit"
                        type="button"
                        @onclick="HandleLogin"
                        disabled="@isBusy">
                    @(isBusy ? "Signing in…" : "Sign In")
                </button>
            </div>
        </section>
    </main>

    <footer class="login-footer">
        <div class="login-footer-brand">
            <span class="login-footer-name">InfraRequest</span>
            <p>© 2024 InfraRequest IT Solutions. All rights reserved.</p>
        </div>
        <nav class="login-footer-nav">
            <a href="javascript:void(0)">Privacy Policy</a>
            <a href="javascript:void(0)">Terms of Service</a>
            <a href="javascript:void(0)">Security Compliance</a>
        </nav>
    </footer>
</div>

@code {
    private string userName = string.Empty;
    private string password = string.Empty;
    private bool rememberMe;
    private string? errorMessage;
    private bool isBusy;

    [SupplyParameterFromQuery] private string? error { get; set; }

    protected override void OnInitialized()
    {
        errorMessage = error switch
        {
            "expired" => "Session expired. Please sign in again.",
            "invalid" => "Your account is inactive. Contact an administrator.",
            _ => null
        };
    }

    private async Task HandleLogin()
    {
        if (string.IsNullOrWhiteSpace(userName) || string.IsNullOrWhiteSpace(password))
        {
            errorMessage = "Please enter your username and password.";
            return;
        }

        isBusy = true;
        errorMessage = null;

        var user = await Auth.ValidateUserAsync(userName, password);

        if (user is null)
        {
            errorMessage = "Invalid username or password.";
            isBusy = false;
            return;
        }

        // Store the validated user ID in cache and redirect to the sign-in endpoint,
        // which issues the real auth cookie (can't set cookies from Blazor interactive mode).
        var token = Guid.NewGuid().ToString("N");
        Cache.Set($"signin:{token}", user.UserId, TimeSpan.FromSeconds(60));
        Nav.NavigateTo($"/account/signin?token={token}", forceLoad: true);
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await HandleLogin();
    }
}
