@page "/reset-password"
@layout AuthLayout
@using InfrastructureRequestApp.Services.Interfaces
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Forms
@inject IUserService Users
@inject AuthenticationStateProvider AuthProvider
@inject NotificationService Notify
@inject NavigationManager Nav

<div class="reset-page">
    <RadzenCard class="reset-card">
        <div class="reset-head">
            <div class="reset-icon"><i class="material-icons">lock_reset</i></div>
            <h2 class="reset-title">Set a new password</h2>
            <p class="reset-sub">
                You signed in with a temporary password. Please choose a new password
                to finish signing in.
            </p>
        </div>

        @if (errorMessage is not null)
        {
            <RadzenAlert Severity="AlertSeverity.Error" AllowClose="false" Text="@errorMessage" class="mb-3" />
        }

        <RadzenTemplateForm TItem="ViewModel" Data="model" Submit="Reset">
            <DataAnnotationsValidator />
            <RadzenStack Gap="1rem">
                <RadzenFormField Text="Current (temporary) password" Variant="Variant.Outlined" Style="width:100%">
                    <ChildContent>
                        <RadzenPassword @bind-Value="model.Current" Name="Current" />
                    </ChildContent>
                    <Helper>
                        <RadzenRequiredValidator Component="Current" Text="Current password is required" />
                    </Helper>
                </RadzenFormField>

                <RadzenFormField Text="New password" Variant="Variant.Outlined" Style="width:100%">
                    <ChildContent>
                        <RadzenPassword @bind-Value="model.New" Name="New" />
                    </ChildContent>
                    <Helper>
                        <RadzenRequiredValidator Component="New" Text="New password is required" />
                        <RadzenLengthValidator Component="New" Min="6" Text="Must be at least 6 characters" />
                    </Helper>
                </RadzenFormField>

                <RadzenFormField Text="Confirm new password" Variant="Variant.Outlined" Style="width:100%">
                    <ChildContent>
                        <RadzenPassword @bind-Value="model.Confirm" Name="Confirm" />
                    </ChildContent>
                    <Helper>
                        <RadzenCompareValidator Component="Confirm" Value="@model.New"
                                                Text="Passwords do not match" />
                    </Helper>
                </RadzenFormField>

                <RadzenButton Text="Update password &amp; continue" Icon="check"
                              ButtonStyle="ButtonStyle.Primary" ButtonType="ButtonType.Submit"
                              Style="width:100%" Disabled="@isBusy" />
            </RadzenStack>
        </RadzenTemplateForm>
    </RadzenCard>
</div>

@code {
    class ViewModel
    {
        public string Current { get; set; } = string.Empty;
        public string New { get; set; } = string.Empty;
        public string Confirm { get; set; } = string.Empty;
    }

    ViewModel model = new();
    string? errorMessage;
    bool isBusy;
    string role = Roles.Standard;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthProvider.GetAuthenticationStateAsync();
        role = state.User.FindFirst(ClaimTypes.Role)?.Value ?? Roles.Standard;
    }

    private async Task Reset()
    {
        var state = await AuthProvider.GetAuthenticationStateAsync();
        var id = state.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        if (id is null)
        {
            Nav.NavigateTo("/login", forceLoad: true);
            return;
        }

        isBusy = true;
        errorMessage = null;

        var ok = await Users.ChangePasswordAsync(Guid.Parse(id), model.Current, model.New);

        if (!ok)
        {
            errorMessage = "The temporary password is incorrect. Please try again.";
            isBusy = false;
            return;
        }

        Notify.Notify(NotificationSeverity.Success, "Password updated", "You can now use your new password.");
        Nav.NavigateTo(role == Roles.Admin ? "/admin" : "/", forceLoad: true);
    }
}
