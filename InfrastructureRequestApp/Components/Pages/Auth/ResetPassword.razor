@page "/reset-password"
@layout AuthLayout
@using InfrastructureRequestApp.Services.Interfaces
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Web
@inject IUserService Users
@inject AuthenticationStateProvider AuthProvider
@inject NotificationService Notify
@inject NavigationManager Nav

<div class="reset-page">
    <div class="reset-card">
        <div class="reset-head">
            <div class="reset-icon"><i class="material-icons">lock_reset</i></div>
            <h2 class="reset-title">Set a new password</h2>
            <p class="reset-sub">
                You signed in with a temporary password. Please choose a new password
                to finish signing in.
            </p>
        </div>

        @if (errorMessage is not null)
        {
            <div class="reset-error">
                <i class="material-icons">error_outline</i>
                <span>@errorMessage</span>
            </div>
        }

        <div class="reset-field">
            <i class="material-icons reset-field-icon">lock</i>
            <input class="reset-input"
                   id="current"
                   type="@(showCurrent ? "text" : "password")"
                   placeholder="Current (temporary) password"
                   @bind="current"
                   @bind:event="oninput" />
            <label class="reset-label" for="current">Current (temporary) password</label>
            <button type="button" class="reset-eye" tabindex="-1"
                    @onclick="() => showCurrent = !showCurrent">
                <i class="material-icons">@(showCurrent ? "visibility_off" : "visibility")</i>
            </button>
        </div>

        <div class="reset-field">
            <i class="material-icons reset-field-icon">lock</i>
            <input class="reset-input"
                   id="new"
                   type="@(showNew ? "text" : "password")"
                   placeholder="New password"
                   @bind="newPassword"
                   @bind:event="oninput" />
            <label class="reset-label" for="new">New password</label>
            <button type="button" class="reset-eye" tabindex="-1"
                    @onclick="() => showNew = !showNew">
                <i class="material-icons">@(showNew ? "visibility_off" : "visibility")</i>
            </button>
        </div>

        <div class="reset-field">
            <i class="material-icons reset-field-icon">lock</i>
            <input class="reset-input"
                   id="confirm"
                   type="@(showConfirm ? "text" : "password")"
                   placeholder="Confirm new password"
                   @bind="confirm"
                   @bind:event="oninput"
                   @onkeydown="OnKeyDown" />
            <label class="reset-label" for="confirm">Confirm new password</label>
            <button type="button" class="reset-eye" tabindex="-1"
                    @onclick="() => showConfirm = !showConfirm">
                <i class="material-icons">@(showConfirm ? "visibility_off" : "visibility")</i>
            </button>
        </div>

        <button class="reset-submit" type="button" @onclick="Reset" disabled="@isBusy">
            <i class="material-icons">check</i>
            <span>@(isBusy ? "Updating…" : "Update password & continue")</span>
        </button>
    </div>
</div>

@code {
    string current = string.Empty;
    string newPassword = string.Empty;
    string confirm = string.Empty;

    bool showCurrent;
    bool showNew;
    bool showConfirm;

    string? errorMessage;
    bool isBusy;
    string role = Roles.Standard;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthProvider.GetAuthenticationStateAsync();
        role = state.User.FindFirst(ClaimTypes.Role)?.Value ?? Roles.Standard;
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await Reset();
    }

    private async Task Reset()
    {
        errorMessage = Validate();
        if (errorMessage is not null) return;

        var state = await AuthProvider.GetAuthenticationStateAsync();
        var id = state.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        if (id is null)
        {
            Nav.NavigateTo("/login", forceLoad: true);
            return;
        }

        isBusy = true;

        var ok = await Users.ChangePasswordAsync(Guid.Parse(id), current, newPassword);

        if (!ok)
        {
            errorMessage = "The temporary password is incorrect. Please try again.";
            isBusy = false;
            return;
        }

        Notify.Notify(NotificationSeverity.Success, "Password updated", "You can now use your new password.");
        Nav.NavigateTo(role == Roles.Admin ? "/admin" : "/", forceLoad: true);
    }

    private string? Validate()
    {
        if (string.IsNullOrWhiteSpace(current)) return "Enter your current (temporary) password.";
        if (string.IsNullOrWhiteSpace(newPassword)) return "Enter a new password.";
        if (newPassword.Length < 6) return "New password must be at least 6 characters.";
        if (newPassword != confirm) return "New password and confirmation do not match.";
        return null;
    }
}
