@page "/change-password"
@using InfrastructureRequestApp.Data.Services.Interfaces
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Forms
@inject IUserService Users
@inject AuthenticationStateProvider AuthProvider
@inject NotificationService Notify

<AuthorizeView>
    <Authorized Context="auth">
        <EditForm Model="model" OnValidSubmit="Change">
            <DataAnnotationsValidator />
            <RadzenCard Style="max-width:520px">
                <h3>Change Password</h3>
                <RadzenPassword @bind-Value="model.Current" Placeholder="Current password" Style="width:100%" />
                <ValidationMessage For="()=>model.Current" />

                <RadzenPassword @bind-Value="model.New" Placeholder="New password" Style="width:100%" />
                <ValidationMessage For="()=>model.New" />

                <RadzenPassword @bind-Value="model.Confirm" Placeholder="Confirm new password" Style="width:100%" />
                <ValidationMessage For="()=>model.Confirm" />
                <RadzenButton class="mt-3" Text="Update" ButtonStyle="ButtonStyle.Primary" Type="Submit" />
            </RadzenCard>
        </EditForm>
    </Authorized>
    <NotAuthorized>
        <RadzenAlert Severity="AlertSeverity.Warning" Text="Please login to change your password." />
    </NotAuthorized>
</AuthorizeView>

@code {
    class ViewModel
    {
        public string Current { get; set; } = string.Empty; 
        public string New { get; set; } = string.Empty; 
        public string Confirm { get; set; } = string.Empty;
    }

    ViewModel model = new();

    private async Task Change()
    {
        if (model.New != model.Confirm)
        {
            Notify.Notify(NotificationSeverity.Warning, "Mismatch", "New password and confirmation do not match.");
            return;
        }

        var state = await AuthProvider.GetAuthenticationStateAsync();
        var id = state.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        if (id is null)
        {
            return;
        }

        var ok = await Users.ChangePasswordAsync(Guid.Parse(id), model.Current, model.New);

        if (ok)
        {
            Notify.Notify(NotificationSeverity.Success, "Password updated", "Your password has been changed.");
        }
        else
        {
            Notify.Notify(NotificationSeverity.Error, "Failed", "Current password is incorrect.");
        }
    }
}
