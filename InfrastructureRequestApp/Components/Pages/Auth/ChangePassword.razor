@page "/change-password"
@using InfrastructureRequestApp.Services.Interfaces
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using System.ComponentModel.DataAnnotations
@inject IUserService Users
@inject AuthenticationStateProvider AuthProvider
@inject NotificationService Notify

<div class="page-header">
    <h2 class="page-title">Change Password</h2>
</div>

<AuthorizeView>
    <Authorized Context="auth">
        <RadzenCard class="form-card">
            <div class="form-card-head">
                <div class="form-icon form-icon-lock"><i class="material-icons">lock</i></div>
                <div>
                    <h3 class="form-card-title">Update your password</h3>
                    <p class="form-card-sub">Choose a strong password you don't use elsewhere.</p>
                </div>
            </div>

            <RadzenTemplateForm TItem="ViewModel" Data="model" Submit="Change">
                <DataAnnotationsValidator />
                <RadzenStack Gap="1rem" class="mt-3">
                    <RadzenFormField Text="Current password" Variant="Variant.Outlined" Style="width:100%">
                        <ChildContent>
                            <RadzenPassword @bind-Value="model.Current" Name="Current" />
                        </ChildContent>
                        <Helper>
                            <RadzenRequiredValidator Component="Current" Text="Current password is required" />
                        </Helper>
                    </RadzenFormField>

                    <RadzenFormField Text="New password" Variant="Variant.Outlined" Style="width:100%">
                        <ChildContent>
                            <RadzenPassword @bind-Value="model.New" Name="New" />
                        </ChildContent>
                        <Helper>
                            <RadzenRequiredValidator Component="New" Text="New password is required" />
                            <RadzenLengthValidator Component="New" Min="6" Text="Must be at least 6 characters" />
                        </Helper>
                    </RadzenFormField>

                    <RadzenFormField Text="Confirm new password" Variant="Variant.Outlined" Style="width:100%">
                        <ChildContent>
                            <RadzenPassword @bind-Value="model.Confirm" Name="Confirm" />
                        </ChildContent>
                        <Helper>
                            <RadzenCompareValidator Component="Confirm" Value="@model.New"
                                                    Text="Passwords do not match" />
                        </Helper>
                    </RadzenFormField>

                    <RadzenButton Text="Update Password" Icon="check" ButtonStyle="ButtonStyle.Primary"
                                  ButtonType="ButtonType.Submit" Style="align-self:flex-start" />
                </RadzenStack>
            </RadzenTemplateForm>
        </RadzenCard>
    </Authorized>
    <NotAuthorized>
        <RadzenAlert Severity="AlertSeverity.Warning" Text="Please login to change your password." />
    </NotAuthorized>
</AuthorizeView>

@code {
    class ViewModel
    {
        public string Current { get; set; } = string.Empty;
        public string New { get; set; } = string.Empty;
        public string Confirm { get; set; } = string.Empty;
    }

    ViewModel model = new();

    private async Task Change()
    {
        var state = await AuthProvider.GetAuthenticationStateAsync();
        var id = state.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        if (id is null) return;

        var ok = await Users.ChangePasswordAsync(Guid.Parse(id), model.Current, model.New);

        if (ok)
        {
            Notify.Notify(NotificationSeverity.Success, "Password updated", "Your password has been changed.");
            model = new();
        }
        else
        {
            Notify.Notify(NotificationSeverity.Error, "Failed", "Current password is incorrect.");
        }
    }
}
