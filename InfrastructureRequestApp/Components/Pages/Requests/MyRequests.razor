@page "/requests"
@using InfrastructureRequestApp.Data.Services.Interfaces
@using Microsoft.AspNetCore.Components.Authorization
@inject IRequestService RequestsSvc
@inject AuthenticationStateProvider AuthProvider
@inject NavigationManager Nav

<div class="page-header">
    <h2 class="page-title">My Requests</h2>
    <RadzenButton Icon="add" Text="New Request"
                  Click='@(() => Nav.NavigateTo("/requests/new"))'
                  ButtonStyle="ButtonStyle.Primary" />
</div>

<RadzenCard>
    <RadzenDataGrid @ref="grid" Data="data" TItem="Request"
                    AllowSorting AllowPaging PageSize="10"
                    EmptyText="You have not submitted any requests yet.">
        <Columns>
            <RadzenDataGridColumn TItem="Request" Property="RequestType" Title="Type" Width="140px" />
            <RadzenDataGridColumn TItem="Request" Property="Description" Title="Description" />
            <RadzenDataGridColumn TItem="Request" Property="Urgency" Title="Urgency" Width="110px">
                <Template Context="r">
                    <span class="urgency-badge urgency-@r.Urgency?.ToLower()">@r.Urgency</span>
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="Request" Property="Note" Title="Note" />
            <RadzenDataGridColumn TItem="Request" Property="Status" Title="Status" Width="130px">
                <Template Context="r">
                    <span class="status-badge status-@r.Status?.Replace(" ", "-")">@r.Status</span>
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="Request" Property="CreatedDate" Title="Created"
                                  Width="150px" FormatString="{0:dd MMM yyyy}" />
        </Columns>
    </RadzenDataGrid>
</RadzenCard>

@code {
    RadzenDataGrid<Request>? grid;
    List<Request> data = new();

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthProvider.GetAuthenticationStateAsync();
        var id = state.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        if (id is not null)
            data = await RequestsSvc.GetMineAsync(Guid.Parse(id));
    }
}
