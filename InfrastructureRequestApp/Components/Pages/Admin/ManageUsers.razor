@page "/admin/users"
@using InfrastructureRequestApp.Services.Interfaces
@using System.ComponentModel.DataAnnotations
@attribute [Authorize(Roles = Roles.Admin)]
@inject IUserService Users
@inject NotificationService Notify

<div class="page-header">
    <h2 class="page-title">Manage Users</h2>
</div>

<RadzenCard class="form-card mb-3">
    <div class="form-card-head">
        <div class="form-icon form-icon-add"><i class="material-icons">person_add</i></div>
        <div>
            <h3 class="form-card-title">Add a new user</h3>
            <p class="form-card-sub">New users receive a temporary password they can change after first login.</p>
        </div>
    </div>

    <RadzenTemplateForm TItem="CreateUserVM" Data="model" Submit="Create">
        <RadzenRow Gap="1rem" class="mt-3" AlignItems="AlignItems.End">
            <RadzenColumn Size="12" SizeMD="3">
                <RadzenFormField Text="Full name" Variant="Variant.Outlined" Style="width:100%">
                    <ChildContent>
                        <RadzenTextBox @bind-Value="model.FullName" Name="FullName" />
                    </ChildContent>
                    <Helper>
                        <RadzenRequiredValidator Component="FullName" Text="Required" />
                    </Helper>
                </RadzenFormField>
            </RadzenColumn>
            <RadzenColumn Size="12" SizeMD="3">
                <RadzenFormField Text="Username" Variant="Variant.Outlined" Style="width:100%">
                    <ChildContent>
                        <RadzenTextBox @bind-Value="model.UserName" Name="UserName" />
                    </ChildContent>
                    <Helper>
                        <RadzenRequiredValidator Component="UserName" Text="Required" />
                    </Helper>
                </RadzenFormField>
            </RadzenColumn>
            <RadzenColumn Size="12" SizeMD="3">
                <RadzenFormField Text="Email" Variant="Variant.Outlined" Style="width:100%">
                    <ChildContent>
                        <RadzenTextBox @bind-Value="model.Email" Name="Email" />
                    </ChildContent>
                    <Helper>
                        <RadzenEmailValidator Component="Email" Text="Enter a valid email" />
                    </Helper>
                </RadzenFormField>
            </RadzenColumn>
            <RadzenColumn Size="12" SizeMD="2">
                <RadzenFormField Text="Role" Variant="Variant.Outlined" Style="width:100%">
                    <RadzenDropDown @bind-Value="model.UserType" Data="roles" />
                </RadzenFormField>
            </RadzenColumn>
            <RadzenColumn Size="12" SizeMD="2">
                <RadzenFormField Text="Temp password" Variant="Variant.Outlined" Style="width:100%">
                    <RadzenPassword @bind-Value="model.Password" />
                </RadzenFormField>
            </RadzenColumn>
            <RadzenColumn Size="12" SizeMD="2">
                <RadzenButton Text="Add User" Icon="add" ButtonStyle="ButtonStyle.Primary"
                              ButtonType="ButtonType.Submit" Style="width:100%" />
            </RadzenColumn>
        </RadzenRow>
    </RadzenTemplateForm>
</RadzenCard>

<RadzenCard>
    <RadzenDataGrid Data="users" TItem="User" AllowSorting AllowPaging PageSize="10" EmptyText="No users found.">
        <Columns>
            <RadzenDataGridColumn TItem="User" Property="FullName" Title="Full Name">
                <Template Context="u">
                    <div class="user-cell">
                        <div class="user-avatar">@(u.FullName?.Length > 0 ? u.FullName[0].ToString().ToUpper() : "?")</div>
                        <span>@u.FullName</span>
                    </div>
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="User" Property="UserName" Title="Username" />
            <RadzenDataGridColumn TItem="User" Property="Email" Title="Email">
                <Template Context="u">@(string.IsNullOrWhiteSpace(u.Email) ? "-" : u.Email)</Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="User" Property="UserType" Title="Role" Width="140px">
                <Template Context="u">
                    <span class="role-pill @(u.UserType == Roles.Admin ? "role-admin" : "role-standard")">@u.UserType</span>
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="User" Property="IsActive" Title="Status" Width="120px">
                <Template Context="u">
                    @if (u.IsActive)
                    {
                        <span class="status-badge status-Completed">Active</span>
                    }
                    else
                    {
                        <span class="status-badge status-Closed">Inactive</span>
                    }
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="User" Property="CreatedDate" Title="Created" Width="150px"
                                  FormatString="{0:dd MMM yyyy}" />
        </Columns>
    </RadzenDataGrid>
</RadzenCard>

@code {
    class CreateUserVM
    {
        [Required] public string FullName { get; set; } = string.Empty;
        [Required] public string UserName { get; set; } = string.Empty;
        public string Email { get; set; } = string.Empty;
        public string UserType { get; set; } = Roles.Standard;
        public string Password { get; set; } = "test";
    }

    CreateUserVM model = new();
    string[] roles = new[] { Roles.Standard, Roles.Admin };
    List<User> users = new();

    protected override async Task OnInitializedAsync()
    {
        users = await Users.GetAllAsync();
    }

    async Task Create()
    {
        var u = new User
        {
            FullName = model.FullName.Trim(),
            UserName = model.UserName.Trim(),
            Email = string.IsNullOrWhiteSpace(model.Email) ? null : model.Email.Trim(),
            UserType = model.UserType,
            IsActive = true,
            CreatedDate = DateTime.UtcNow
        };

        await Users.CreateAsync(u, model.Password);
        Notify.Notify(NotificationSeverity.Success, "User added", $"{model.FullName} created.");

        users = await Users.GetAllAsync();
        model = new();
    }
}
