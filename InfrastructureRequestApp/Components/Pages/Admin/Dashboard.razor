@page "/admin"
@using InfrastructureRequestApp.Services.Interfaces
@attribute [Authorize(Roles = Roles.Admin)]
@inject IRequestService RequestsSvc
@inject NavigationManager Nav

<div class="page-header">
    <h2 class="page-title">All Requests</h2>
</div>

<RadzenCard>
    <RadzenDataGrid Data="data" TItem="Request"
                    AllowFiltering="true" AllowSorting="true"
                    AllowPaging="true" PageSize="12"
                    EmptyText="No requests found.">
        <Columns>
            <RadzenDataGridColumn TItem="Request" Property="RequestType" Title="Type" Width="150px" />
            <RadzenDataGridColumn TItem="Request" Property="CreatedByNavigation.FullName" Title="Requested By" Width="170px">
                <Template Context="r">@(r.CreatedByNavigation?.FullName ?? "-")</Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="Request" Property="Description" Title="Description" />
            <RadzenDataGridColumn TItem="Request" Property="Urgency" Title="Urgency" Width="150px">
                <Template Context="r">
                    <span class="urgency-badge urgency-@r.Urgency?.ToLower()">@r.Urgency</span>
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="Request" Property="Status" Title="Status" Width="160px">
                <Template Context="r">
                    <span class="status-badge status-@r.Status?.Replace(" ", "-")">@r.Status</span>
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="Request" Property="CreatedDate" Title="Created"
                                  Width="150px" Filterable="false" FormatString="{0:dd MMM yyyy}" />
            <RadzenDataGridColumn TItem="Request" Title="" Width="90px" Sortable="false" Filterable="false">
                <Template Context="r">
                    <RadzenButton Text="Open" Size="ButtonSize.Small"
                                  ButtonStyle="ButtonStyle.Primary"
                                  Click="@(() => Nav.NavigateTo($"/admin/requests/{r.RequestId}"))" />
                </Template>
            </RadzenDataGridColumn>
        </Columns>
    </RadzenDataGrid>
</RadzenCard>

@code {
    List<Request> data = new();
    protected override async Task OnInitializedAsync() => data = await RequestsSvc.GetAllAsync();
}
