@page "/admin/requests/{Id}"
@using InfrastructureRequestApp.Data.Services.Interfaces
@attribute [Authorize(Roles = Roles.Admin)]
@inject IRequestService RequestsSvc
@inject IUserService Users
@inject NotificationService Notify
@inject NavigationManager Nav

<h3>Request Details</h3>

@if (req is null)
{
    <RadzenProgressBar Mode="ProgressBarMode.Indeterminate" />
}
else
{
    <RadzenCard>
        <div class="grid" style="grid-template-columns:1fr 1fr; gap:16px;">
            <div>
                <p><b>ID:</b> @req.RequestId</p>
                <p><b>Type:</b> @req.RequestType</p>
                <p><b>Urgency:</b> @req.Urgency</p>
                <p><b>Status:</b> @req.Status</p>
            </div>
            <div>
                <p><b>Requested By:</b> @(req.CreatedByNavigation?.FullName ?? "-")</p>
                <p><b>Created:</b> @req.CreatedDate.ToLocalTime()</p>
                <p><b>Assigned To:</b> @(assignedToName ?? "-")</p>
            </div>
        </div>
        <p><b>Description:</b><br /> @req.Description</p>

        @if (!string.IsNullOrWhiteSpace(req.Note))
        {
            <p><b>Note:</b><br /> @req.Note</p>
        }
        <div class="mt-3">
            <RadzenDropDown Data="statuses" @bind-Value="status" Style="min-width:220px" />
            <RadzenDropDown Data="admins" TextProperty="FullName"
                            ValueProperty="UserId" @bind-Value="assignedTo" Placeholder="Assign to (optional)" Style="min-width:260px" />
            <RadzenButton class="ml-2" Text="Update" ButtonStyle="ButtonStyle.Primary" Click="UpdateStatus" />
        </div>
    </RadzenCard>

    <RadzenCard class="mt-3">
        <h4>Comments</h4>
        <ul>
            @foreach (var c in req.RequestComments.OrderByDescending(x => x.CommentDate))
            {
                <li>
                    <b>@c.CommentedByUser?.FullName</b> (@c.CommentDate.ToLocalTime()):
                    <div>@c.CommentText</div>
                </li>
            }
        </ul>
        <div class="mt-2">
            <RadzenTextArea @bind-Value="newComment" Rows="3" Style="width:100%"
                            Placeholder="Add a comment..." />
            <RadzenButton class="mt-2" Text="Add Comment" Click="AddComment" />
        </div>
    </RadzenCard>
}

@code {
    [Parameter] public string Id { get; set; } = string.Empty;

    Request? req;
    string[] statuses = new[] { "Pending", "In Progress", "Completed", "Closed" };
    string status = "Pending";
    List<User> admins = new();
    Guid? assignedTo;
    string? assignedToName;
    string newComment = string.Empty;

    protected override async Task OnParametersSetAsync()
    {
        if (!Guid.TryParse(Id, out var guid))
        {
            Notify.Notify(NotificationSeverity.Error, "Invalid Request", "The request ID is invalid or missing.");
            Nav.NavigateTo("/admin");
            return;
        }

        req = await RequestsSvc.GetByIdAsync(guid);
        if (req is not null)
        {
            status = req.Status;
            admins = (await Users.GetAllAsync()).Where(u => u.UserType == Roles.Admin).ToList();
            assignedTo = req.AssignedTo;
            assignedToName = admins.FirstOrDefault(a => a.UserId == assignedTo)?.FullName;
        }
    }

    async Task UpdateStatus()
    {
        if (!Guid.TryParse(Id, out var guid)) return;

        await RequestsSvc.UpdateStatusAsync(guid, status, assignedTo);
        Notify.Notify(NotificationSeverity.Success, "Updated", "Status/assignment updated.");
        req = await RequestsSvc.GetByIdAsync(guid);
    }

    async Task AddComment()
    {
        if (string.IsNullOrWhiteSpace(newComment)) return;
        if (!Guid.TryParse(Id, out var guid)) return;

        await RequestsSvc.AddCommentAsync(guid, admins.First().UserId, newComment);
        newComment = string.Empty;
        req = await RequestsSvc.GetByIdAsync(guid);
    }
}
